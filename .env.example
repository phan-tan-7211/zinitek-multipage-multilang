# Public site URL. For Vercel previews this can be omitted because runtime-config
# can derive the deployment URL from Vercel-provided variables.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Required Sanity connection for this company/deployment.
# Each company should point to its own Sanity project/dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-side recipient for website contact/quotation forms.
CONTACT_RECIPIENT_EMAIL=contact@example.com
